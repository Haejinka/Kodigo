      "text": "Background and case scenario"
    },
    {
      "kind": "textbox",
      "text": "03 / 17"
    },
    {
      "kind": "textbox",
      "text": "Separate sales and stock records create delayed visibility"
    },
    {
      "kind": "textbox",
      "text": "Manual entry and later reconciliation make owners compare\nseveral records before routine decisions."
    },
    {
      "kind": "textbox",
      "text": "Sale recorded"
    },
    {
      "kind": "textbox",
      "text": "Stock encoded later"
    },
    {
      "kind": "textbox",
      "text": "Owner reconciles\nbefore ordering"
    },
    {
      "kind": "textbox",
      "text": "Illustrative scenario based on the manuscript’s operational problem"
    }
  ],
